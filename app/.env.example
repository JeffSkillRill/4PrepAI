# Local development must target local Supabase or Jeff's separate QA project.
# Never paste the production project URL here for routine development or QA.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-cloud-anon-key

# Keep false. In a development build, account deletion is blocked when the URL
# above is the known production project. Set true only for an explicitly
# approved, supervised production-deletion test.
VITE_ALLOW_PRODUCTION_DESTRUCTIVE_OPERATIONS=false

# Set only as Supabase Edge Function secrets. Never prefix these with VITE_.
PPLX_API_KEY=
PPLX_MODEL=sonar
