{
  "name": "4prep-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "overrides": {
    "nanoid@3": "3.3.20",
    "brace-expansion": "5.0.12",
    "undici@7": "7.30.0",
    "postcss": "8.5.29",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check:functions": "deno check --node-modules-dir=none supabase/functions/counselor/index.ts supabase/functions/delete-account/index.ts supabase/functions/admin-api/index.ts supabase/functions/submit-lead/index.ts supabase/functions/client-events/index.ts supabase/functions/launch-ops/index.ts",
    "ssr:smoke": "vite build --ssr scripts/smoke.tsx --outDir .smoke-out && node .smoke-out/smoke.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.11",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
}
