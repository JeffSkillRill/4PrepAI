# Copy to qa/.env (gitignored). Never commit real values.
QA_SUPABASE_URL=https://<ref>.supabase.co
QA_SUPABASE_ANON_KEY=
# Required for seed, teardown, reconcile, and authz setup. Paste it yourself; never share it in chat.
QA_SUPABASE_SERVICE_ROLE_KEY=
QA_APP_URL=https://4-prep-ai2.vercel.app
# Number of seeded qa_load_ users (authenticated virtual-student pool).
QA_USER_COUNT=120
# Must be set to this exact value in the shell for any run against the production ref.
# QA_ALLOW_PRODUCTION=yes-owner-approved
