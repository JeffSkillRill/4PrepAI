{
  "manifest_version": 3,
  "name": "4PrepAI QS profile review ingest",
  "version": "1.0.0",
  "description": "Review QS profile data and collect it to local files before any database import.",
  "permissions": ["activeTab", "storage", "downloads"],
  "host_permissions": ["https://www.topuniversities.com/*", "https://pubhgajlqhdbpwqahtki.supabase.co/*"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["https://www.topuniversities.com/universities/*"], "js": ["dist/content.js"] }]
}
